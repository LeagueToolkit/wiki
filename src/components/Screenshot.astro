---
/**
 * A screenshot from `src/assets/screenshots/`, or a placeholder that names the
 * missing file.
 *
 * `file` is the path under `src/assets/screenshots/`, such as
 * `manager/home-rail.webp`. Adding that file replaces the placeholder with the
 * optimized image, so the page needs no edit.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  file: string;
  alt: string;
}

const { file, alt } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/screenshots/**/*.{webp,png}',
  { eager: true },
);
const image = images[`/src/assets/screenshots/${file}`]?.default;
---

{
  image ? (
    <Image src={image} alt={alt} />
  ) : (
    <figure class="screenshot-missing not-content">
      <p class="label">Screenshot needed</p>
      <p>
        <code>src/assets/screenshots/{file}</code>
      </p>
      <figcaption>{alt}</figcaption>
    </figure>
  )
}

<style>
  .screenshot-missing {
    display: grid;
    gap: 0.25rem;
    margin-block: 1rem;
    padding: 2rem 1.25rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: var(--ltk-radius-lg);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    text-align: center;
  }

  .label {
    margin: 0;
    color: var(--sl-color-white);
    font-weight: var(--ltk-weight-medium);
  }

  p,
  figcaption {
    margin: 0;
  }
</style>
