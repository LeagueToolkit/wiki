---
/**
 * Splash-page hero: the statement and actions beside a real app capture that
 * runs off the viewport's end edge.
 *
 * Copy, the capture (`hero.image.file`) and the fine print (`heroNote`) come
 * from the page's frontmatter, so index.mdx stays the single place to edit.
 */
import CaptureFrame from '../home/CaptureFrame.astro';

// Starlight's PAGE_TITLE_ID, inlined: the constant lives behind an internal
// specifier that is not exported from the package.
const PAGE_TITLE_ID = '_top';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [], image } = data.hero || {};
const capture = image && 'file' in image ? image : undefined;
---

<div class:list={['ltk-hero', { 'has-capture': capture }]}>
  <div class="copy">
    <h1 id={PAGE_TITLE_ID} data-page-title set:html={title} />
    {tagline && <p class="tagline" set:html={tagline} />}
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ link: href, text, variant }) => (
            <a {href} class:list={['action', variant === 'minimal' ? 'ghost' : 'primary']}>
              {text}
              <svg class="arrow" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
                <path
                  d="M2 8h11M9 4l4 4-4 4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          ))}
        </div>
      )
    }
    {data.heroNote && <p class="note">{data.heroNote}</p>}
  </div>
  {
    capture && (
      <div class="capture">
        <CaptureFrame bleed>
          <img
            src={capture.file.src}
            width={capture.file.width}
            height={capture.file.height}
            alt={capture.alt}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </CaptureFrame>
      </div>
    )
  }
</div>

<style>
  /* The capture's overshoot past the viewport edge must not scroll the page. */
  :global(html:has(.ltk-hero.has-capture)) {
    overflow-x: clip;
  }

  .ltk-hero {
    position: relative;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(2.5rem, 8vmin, 5.5rem) clamp(1rem, 3vmin, 2rem);
  }

  @media (min-width: 60rem) {
    .ltk-hero.has-capture {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 3.5rem;
    }
  }

  .ltk-hero:not(.has-capture) {
    justify-items: center;
    text-align: center;
  }

  .ltk-hero h1 {
    margin: 0;
    font-family: var(--ltk-font-display);
    font-size: clamp(2.75rem, 6vw, 4.5rem);
    font-weight: var(--ltk-weight-bold);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }

  .ltk-hero h1 :global(.accent) {
    background: var(--ltk-wordmark);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tagline {
    max-width: 48ch;
    margin: 1.5rem 0 0;
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    text-wrap: pretty;
    color: var(--sl-color-gray-2);
  }

  .note {
    margin: 1rem 0 0;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
  }

  /* Distance from the content column's end edge to the viewport's. */
  .capture {
    --bleed: calc((100vw - min(var(--sl-content-width), 100vw - 2 * var(--sl-content-pad-x))) / 2);
    margin-inline-end: calc(-1 * var(--bleed));
  }

  /* ── Actions ──────────────────────────────────────────────── */

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Phone widths: each action takes a full row rather than one wrapping
     under the other. */
  @media (max-width: 30rem) {
    .action {
      flex: 1 1 100%;
      justify-content: center;
    }
  }

  .ltk-hero:not(.has-capture) .actions {
    justify-content: center;
  }

  .action {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.35rem;
    border: 1px solid transparent;
    border-radius: var(--ltk-radius-md);
    font-size: 0.9375rem;
    font-weight: var(--ltk-weight-semibold);
    text-decoration: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease,
      background-color 0.2s ease;
  }

  .action:hover {
    transform: translateY(-1px);
  }

  .arrow {
    transition: transform 0.15s ease;
  }

  .action:hover .arrow {
    transform: translateX(2px);
  }

  .ghost .arrow {
    color: var(--sl-color-gray-3);
  }

  .primary {
    background: linear-gradient(135deg, var(--ltk-violet), var(--ltk-blue));
    color: var(--ltk-on-brand);
    box-shadow: var(--ltk-glow-brand);
  }

  .primary:hover {
    box-shadow: var(--ltk-glow-brand-hover);
  }

  .ghost {
    border-color: var(--sl-color-gray-4);
    color: var(--sl-color-white);
  }

  .ghost:hover {
    border-color: var(--sl-color-gray-3);
    background-color: var(--sl-color-gray-6);
  }

  .action:focus-visible {
    outline: 2px solid var(--sl-color-accent-high);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .action,
    .action:hover,
    .arrow,
    .action:hover .arrow {
      transform: none;
    }
  }
</style>
