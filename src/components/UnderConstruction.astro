---
/**
 * Body of a page that has no content yet. The page keeps its title, tags and
 * sidebar entry so that the section's structure is complete.
 */
---

<div class="under-construction not-content" role="note">
  <p class="title">Under construction</p>
  <p>This page has no content yet.</p>
</div>

<style>
  .under-construction {
    margin-block: 1.5rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--sl-color-gray-4);
    border-radius: var(--ltk-radius-lg);
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-2);
  }

  .title {
    margin: 0 0 0.25rem;
    color: var(--sl-color-white);
    font-weight: var(--ltk-weight-medium);
  }

  p {
    margin: 0;
  }
</style>
